#!/usr/bin/env luajit
-- Share pinned Unicode data, not executable collation logic, with Rust.
local function read(path)
	local file = assert(io.open(path, 'rb'))
	local data = file:read('*a'); file:close(); return data
end
local oracle = read('src/collation_oracle.zig')
local words = read('src/word_break_data.zig')
local structure = read('src/structural_data.zig')
local output = assert(io.open(arg[1] or 'rust/src/tables.rs', 'wb'))
output:write('// Generated by tools/gen-rust-tables from the pinned Unicode/house tables.\n')
output:write('#[rustfmt::skip]\npub const FOLDS: &[(u32,u8,u8,bool)] = &[\n')
local folds = 0
for cp, base, dia, upper in oracle:gmatch("%.cp = (0x%x+), %.base = '(.)', %.dia = (%d+), %.upper = (%a+)") do
	output:write(string.format("(%s,b'%s',%s,%s),\n", cp, base, dia, upper)); folds = folds + 1
end
assert(folds > 100)
output:write('];\n#[rustfmt::skip]\npub const EXPANSIONS: &[(u32,&[u8])] = &[\n')
local expansions = 0
for cp, text in oracle:gmatch('%.cp = (0x%x+), %.replacement = "([^"]+)"') do
	output:write(string.format('(%s,b"%s"),\n', cp, text)); expansions = expansions + 1
end
assert(expansions > 50)
output:write('];\n#[rustfmt::skip]\npub const WORD_RANGES: &[(u32,u32,u8)] = &[\n')
local properties = {}
local enum = assert(words:match('pub const Property = enum%(u8%) {(.-)};'))
local count = 0
for property in enum:gmatch('([%w_]+),') do properties[property] = count; count = count + 1 end
local ranges = 0
for first, last, property in words:gmatch('%.first = (0x%x+), %.last = (0x%x+), %.property = %.([%w_]+)') do
	output:write(string.format('(%s,%s,%d),\n', first, last, assert(properties[property]))); ranges = ranges + 1
end
assert(ranges > 1000)
output:write('];\n')
local function structural_ranges(name)
	local section = assert(structure:match('pub const ' .. name .. ' = %[_%]Range{(.-)};'))
	local result = {}
	for first,last in section:gmatch('%.first = (0x%x+), %.last = (0x%x+)') do result[#result+1] = {first,last} end
	assert(#result > 5, 'empty structural ranges: ' .. name)
	return result
end
output:write('#[rustfmt::skip]\npub const PUNCTUATION: &[(u32,u32)] = &[\n')
for _,range in ipairs(structural_ranges('punctuation')) do output:write('(',range[1],',',range[2],'),\n') end
output:write('];\n#[rustfmt::skip]\n#[inline]\npub fn is_space(cp: u32) -> bool { matches!(cp, ')
for i,range in ipairs(structural_ranges('whitespace')) do
	if i>1 then output:write(' | ') end
	output:write(range[1]); if range[1]~=range[2] then output:write('..=',range[2]) end
end
output:write(') }\n')
for _, property in ipairs({'other','a_letter','hebrew_letter','extend','format','zwj',
    'mid_letter','mid_num_let','single_quote','extend_num_let','numeric'}) do
	output:write(string.format('pub const WB_%s: u8 = %d;\n', property:upper(), assert(properties[property])))
end
assert(output:close())
