#!/usr/bin/env bash
# Master test runner for romantic_collation.
# Runs Zig unit tests + CLI integration tests.
# Exit code = total number of failures across all suites.
#
# Per Mecha conventions: never use `set -euo pipefail` in test scripts.
# `set -e` silently aborts when a command-under-test returns non-zero, which
# masks the intended-failure paths.
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR" || exit 1
if [[ -z "${NIX_BUILD_TOP:-}" ]]; then
	# The derivation runs this same complete suite in disposable build state.
	test_system=$(nix eval --impure --raw --expr builtins.currentSystem) || exit $?
	nix build ".#checks.$test_system.test" --out-link result-test || exit $?
	cat result-test/test.log
	exit 0
fi
TOTAL_FAIL=0
TOTAL_PASS=0

run_suite() {
	local name="$1"
	local cmd="$2"
	echo ""
	echo "━━━ $name ━━━"
	local output
	output=$(eval "$cmd" 2>&1)
	local rc=$?
	local pass fail
	# Recognize multiple summary formats:
	#   - shell-style "N passed" / "N failed"
	#   - Zig --summary all success: "N/N tests passed"
	#   - Zig --summary all failure: "N pass, N fail (M total)"
	pass=$(echo "$output" | grep -oE '[0-9]+(/[0-9]+)?( tests?)? pass(ed)?' | head -1 | grep -oE '^[0-9]+' || echo "0")
	fail=$(echo "$output" | grep -oE '[0-9]+( tests?)? fail(ed)?' | head -1 | grep -oE '^[0-9]+' || echo "0")
	if [[ $rc -ne 0 && "$fail" == "0" ]]; then
		fail=1
	fi
	TOTAL_PASS=$((TOTAL_PASS + pass))
	TOTAL_FAIL=$((TOTAL_FAIL + fail))
	if [[ $rc -eq 0 ]]; then echo "$output" | tail -8; else echo "$output"; fi
}

echo "╔══════════════════════════════════════════════════════════════╗"
echo "║   romantic_collation Master Test Suite                       ║"
echo "╚══════════════════════════════════════════════════════════════╝"

# Build first (ReleaseFast for CLI tests; nix-sandboxed).
echo ""
echo "Building (ReleaseFast)..."
zig build -Doptimize=fast --prefix "$SCRIPT_DIR/zig-out" || { echo "FATAL: build failed"; exit 1; }
zig_test_cmd="zig build test -Doptimize=safe --summary all 2>&1"
c_test_cmd="zig build c-test -Doptimize=safe --summary all 2>&1"

# Zig unit tests — `--summary all` makes Zig emit "N/N tests passed"
# which run_suite's grep can pick up.
run_suite "Zig Unit Tests" "$zig_test_cmd"

# C adapter tests inject FFI failures that the successful Zig implementation
# cannot produce on demand.
run_suite "C CLI Adapter Unit Tests" "$c_test_cmd"
run_suite "CLI key memory" "zig build arena-test -Doptimize=safe --summary all"
run_suite "C ABI consumer" "zig build abi-test -Doptimize=safe --summary all"
run_suite "Installed C ABI consumer" "cc -std=c11 -Wall -Wextra -Werror -I'$RCOL_LIBRARY/include' tests/unit/ffi_contract.c '$RCOL_LIBRARY/lib/libromantic_collation.a' -o '$SCRIPT_DIR/abi-consumer' && '$SCRIPT_DIR/abi-consumer'"
run_suite "Rust installed C ABI consumer" "cc -std=c11 -Wall -Wextra -Werror -I'$RCOL_RUST_LIBRARY/include' tests/unit/ffi_contract.c '$RCOL_RUST_LIBRARY/lib/libromantic_collation.a' -lm -lpthread -o '$SCRIPT_DIR/abi-rust-consumer' && '$SCRIPT_DIR/abi-rust-consumer'"
run_suite "Zig oracle / Rust key-byte parity" "'$RCOL_PARITY' '$RCOL_ZIG_SHARED' '$RCOL_RUST_SHARED'"
run_suite "Public ABI inventory and negative control" "bash tests/unit/abi_inventory.sh"
run_suite "Generated Rust tables" "luajit tools/gen-rust-tables generated-tables.rs && cmp rust/src/tables.rs generated-tables.rs && echo '1 passed, 0 failed'"
run_suite "Generated Unicode structural table" "luajit tools/gen-structural-data '$RCOL_UNICODE_DATA' '$RCOL_PROP_LIST' generated-structure.zig && cmp src/structural_data.zig generated-structure.zig && echo '1 passed, 0 failed'"
run_suite "Zig Unicode structural properties" "'$RCOL_STRUCTURE_ORACLE' '$RCOL_ZIG_SHARED' '$RCOL_UNICODE_DATA' '$RCOL_PROP_LIST'"
run_suite "Rust Unicode structural properties" "'$RCOL_STRUCTURE_ORACLE' '$RCOL_RUST_SHARED' '$RCOL_UNICODE_DATA' '$RCOL_PROP_LIST'"
run_suite "Rust-backed Elixir NIF" "cat '$RCOL_ELIXIR_LOG' && echo '9 passed, 0 failed'"

# Benchmark policy is pure classification and belongs in the ordinary suite;
# actual timing remains exclusive to ./bm.
run_suite "Benchmark Policy Unit Tests" "bash '$SCRIPT_DIR/tests/unit/benchmark_policy.sh'"
run_suite "Build failure propagation" "bash '$SCRIPT_DIR/tests/unit/build_failure.sh'"
run_suite "Backend selection and isolated publication" "bash tests/unit/build_selection.sh"

# Integration tests (CLI surface) — add as they're written
for t in "$SCRIPT_DIR"/tests/integration/*.sh; do
	[[ -f "$t" ]] || continue
	case $(basename "$t") in
		database.sh|readme_translations.sh) run_suite "Integration: $(basename "$t")" "bash '$t'" ;;
		*)
			run_suite "Zig CLI: $(basename "$t")" "COLLATE_CLI='$RCOL_ZIG_CLI' bash '$t'"
			run_suite "Rust CLI: $(basename "$t")" "COLLATE_CLI='$RCOL_RUST_CLI' bash '$t'"
			;;
	esac
done

echo ""
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║  TOTAL: $TOTAL_PASS passed, $TOTAL_FAIL failed"
echo "╚══════════════════════════════════════════════════════════════╝"

exit $TOTAL_FAIL
